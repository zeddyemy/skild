{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"**/*.ts",
			"**/*.tsx",
			"**/*.json",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css",
			"!**/src/dataconnect-generated/**/*",
			"!**/node_modules/**/*",
			"!**/.tanstack/**/*",
			"!**/.output/**/*",
			"!**/.nitro/**/*",
			"!**/dist/**/*"
		]
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": true,
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
